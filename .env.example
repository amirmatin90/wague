# Hyperliquid TESTNET only. Do not set master, withdraw, or mainnet keys.
HL_NETWORK=testnet
HL_API_URL=https://api.hyperliquid-testnet.xyz

# Optional. Quotes use the public testnet book without a key.
# Execute requires this agent key. Never commit the value.
# HL_AGENT_KEY_TESTNET=

DATABASE_URL=postgresql+psycopg://otc:otc_local@postgres:5432/otc
JWT_SECRET=local-dev-jwt-not-for-production
QUOTE_TTL_MS=20000
