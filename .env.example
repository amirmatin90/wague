# Hyperliquid TESTNET only. Do not set master, withdraw, or mainnet keys.
HL_NETWORK=testnet
HL_API_URL=https://api.hyperliquid-testnet.xyz

# Optional. Quotes use the public testnet book without a key.
# Execute requires the agent key AND the master that approved it. Never commit these values.
# HL_AGENT_KEY_TESTNET=0x...   # agent private key from app.hyperliquid-testnet.xyz/API
# HL_MASTER_ADDRESS=0x...      # master account address that approved the agent AND holds testnet spot

DATABASE_URL=postgresql+psycopg://otc:otc_local@postgres:5432/otc
JWT_SECRET=local-dev-jwt-not-for-production
QUOTE_TTL_MS=20000
